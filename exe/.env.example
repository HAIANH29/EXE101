
DB_URL=jdbc:postgresql://<db-host>:<db-port>/<db-name>?sslmode=require
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>

JWT_SECRET=<jwt-secret-at-least-32-characters>
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=2592000000



SEPAY_BASE_URL=https://api.sepay.vn
SEPAY_API_KEY=<sepay-api-key>
SEPAY_ACCOUNT_NUMBER=<sepay-account-number>
SEPAY_BANK_CODE=<bank-code>


AI_BASE_URL=http://localhost:8000


REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

PASSWORD_RESET_MAIL_ENABLED=false
PASSWORD_RESET_EXPIRATION_MINUTES=30
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-app-password>
MAIL_FROM=StyleLock <noreply@example.com>

CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

SERVER_PORT=8080
