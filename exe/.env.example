SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://<db-host>:<db-port>/<db-name>?sslmode=require
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>

JWT_SECRET=<jwt-secret-at-least-32-characters>
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=2592000000

# URL công khai của backend (local: http://localhost:8080)
# Render: https://exe101-cb0b.onrender.com
APP_PUBLIC_BASE_URL=http://localhost:8080
# Danh sách origin FE được phép gọi API, phân tách bằng dấu phẩy
APP_CORS_ALLOWED_ORIGINS=http://localhost:8082,http://localhost:8081,http://localhost:19006,http://localhost:3000,http://localhost:5173
APP_FRONTEND_RESET_URL=http://localhost:8082/reset-password

SEPAY_BASE_URL=https://api.sepay.vn
SEPAY_API_KEY=<sepay-api-key>
SEPAY_ACCOUNT_NUMBER=<sepay-account-number>
SEPAY_BANK_CODE=<bank-code>
# Webhook SePay: <APP_PUBLIC_BASE_URL>/... — dùng secret dài, khó đoán
SEPAY_WEBHOOK_SECRET=<sepay-webhook-secret>

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
# Phải khớp Authorized redirect URI trong Google Cloud Console
# Render: https://exe101-cb0b.onrender.com/login/oauth2/code/google
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

PASSWORD_RESET_EXPIRATION_MINUTES=30
MAIL_ENABLED=false
MAIL_PROVIDER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-app-password>
MAIL_FROM=<sender-email>
MAIL_FROM_NAME=StyleLock

CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

REPLICATE_API_TOKEN=<replicate-api-token>
GEOAPIFY_API_KEY=<geoapify-api-key>
STYLELOCK_DEMO_ENABLED=true
STYLELOCK_DEMO_OWNER_EMAIL=demo.owner@stylelock.local
STYLELOCK_DEMO_OWNER_PASSWORD=DemoOwner123!
REPLICATE_HAIR_MODEL=google/nano-banana-2

SERVER_PORT=8080
