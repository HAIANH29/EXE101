# Copy to .env for local development. Do not commit real secrets.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5433/stylelock
DB_USERNAME=stylelock
DB_PASSWORD=stylelock

JWT_SECRET=local-dev-secret-change-me-local-dev-secret-change-me
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=2592000000

APP_CORS_ALLOWED_ORIGINS=http://localhost:8082,http://localhost:8081,http://localhost:19006,http://localhost:3000

PASSWORD_RESET_EXPIRATION_MINUTES=30
PASSWORD_RESET_MAIL_ENABLED=false
APP_FRONTEND_RESET_URL=http://localhost:8082/reset-password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

SEPAY_BASE_URL=https://my.sepay.vn/userapi
SEPAY_API_TOKEN=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=
SEPAY_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:8081/oauth2/redirect

OPENAI_API_KEY=
