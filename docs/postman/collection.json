  "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is an API status', function () { pm.expect([200,400,401,403,404,409,500]).to.include(pm.response.code); });", "pm.test('response time is below 1000 ms', function () { pm.expect(pm.response.responseTime).to.be.below(1000); });", "if (pm.response.headers.get('Content-Type') && pm.response.headers.get('Content-Type').includes('json')) { const j=pm.response.json(); pm.test('wrapper has success boolean', function () { pm.expect(j).to.have.property('success'); pm.expect(j.success).to.be.a('boolean'); }); if (j.timestamp !== undefined) pm.test('timestamp is string', function () { pm.expect(j.timestamp).to.be.a('string'); }); if (j.success === true && j.data && j.data.accessToken !== undefined) pm.test('accessToken is string when returned', function () { pm.expect(j.data.accessToken).to.be.a('string'); }); }" ] } }]
